# Environnement Python
.venv/
venv/
env/
ENV/

# Bytecode Python & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Modèles volumineux & Binaires sérialisés (Joblib / Pickle)
# Seul models/metrics.json (à la racine) doit être versionné
models/*
!models/.gitkeep
!models/metrics.json
*.joblib
*.pkl
# Modèle embarqué dans le paquet (TP4) : présent dans la roue, exclu de Git
incidents_app/models/*.joblib
!incidents_app/models/.gitkeep

# Données volumineuses (CSVs bruts ou nettoyés volumineux)
data/*
!data/.gitkeep
!data/sample/
!data/sample/**
!data/sample_reviews.csv
# Runbooks IT (versionnés : base de connaissances RAG)
!data/runbooks/
!data/runbooks/**/*.md
# Base vectorielle Chroma (générée, exclue de Git)
chroma_db/

# Tests & qualité
.hypothesis/
.mypy_cache/
.ruff_cache/

# Éditeurs et système
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build & packaging
dist/
build/
*.egg-info/

# Archives & artefacts temporaires
*.zip
*.tar.gz
*.rar
*.7z
scratch/
scratch_*

# Documents et archives non sollicités
*.pdf

# Images temporaires à la racine du dépôt (les captures dans docs/captures/ restent autorisées)
/*.png
/*.jpg
/*.jpeg

# Secrets
.env

# Rapport de vérification TP4 (non commité : rejoint la release GitHub avec dist/)
docs/livrable-tp4.txt
