# Environnement Python
.venv/
venv/
env/
ENV/

# Bytecode Python & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Modèles volumineux & Binaires sérialisés (Joblib / Pickle)
# Seul models/metrics.json (à la racine) doit être versionné
models/*
!models/.gitkeep
!models/metrics.json
*.joblib
*.pkl
# Copies embarquées dans la roue (scripts/preparer_roue.py) : présentes dans le paquet, exclues de Git
incidents_app/models/*.joblib
!incidents_app/models/.gitkeep
incidents_app/runbooks/

# Données volumineuses (CSVs bruts ou nettoyés volumineux)
data/*
!data/.gitkeep
!data/sample/
!data/sample/**
!data/README.md
# Runbooks IT (versionnés : base de connaissances RAG)
!data/runbooks/
!data/runbooks/**/*.md
# Base vectorielle Chroma et suivi MLflow (générés, exclus de Git)
chroma_db/
mlruns/

# Tests & qualité
.hypothesis/
.mypy_cache/
.ruff_cache/

# Éditeurs et système
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build & packaging
dist/
build/
*.egg-info/
# Installateur Windows : plus de 60 Mo, joint à la release, jamais dans le dépôt
installateur/build/
installateur/Output/

# Archives & artefacts temporaires
*.zip
!modele-rapport-latex.zip
*.tar.gz
*.rar
*.7z
scratch/
scratch_*

# PDF à la racine (le compte rendu et le support de soutenance vont dans docs/)
/*.pdf

# Images temporaires à la racine du dépôt (les captures dans docs/captures/ restent autorisées)
/*.png
/*.jpg
/*.jpeg

# Secrets
.env

# Rapport de vérification TP4 (non commité : rejoint la release GitHub avec dist/)
docs/livrable-tp4.txt
